late-deep);margin-right:8px}\n\n/* 客户端 */\n.clients{background:var(--slate);color:#c9d5db}\n.clients h2{color:#fff}\n.clients .sec-intro{color:#8fa0ac}\n.client-note{background:var(--slate-deep);border-left:4px solid var(--teal);padding:24px 26px;font-size:15px;max-width:640px}\n.client-note strong{color:#fff}\n\n/* 步骤 */\n.steps{counter-reset:step}\n.step{display:flex;gap:22px;padding:26px 0;border-bottom:1px solid var(--line)}\n.step:last-child{border-bottom:none}\n.step .n{flex:0 0 54px;font-size:40px;font-weight:800;color:var(--teal);line-height:1.1}\n.step h3{font-size:17px;color:var(--slate-deep);margin-bottom:6px}\n.step p{font-size:14.5px;color:var(--slate-mid)}\n\n/* FAQ 编号列表 */\n.faq{background:#fff;border-top:1px solid var(--line)}\n.faq ol{list-style:none;counter-reset:faq}\n.faq li{counter-increment:faq;padding:26px 0 26px 74px;border-bottom:1px solid var(--line);position:relative}\n.faq li::before{content:counter(faq,decimal-leading-zero);position:absolute;left:0;top:24px;font-size:30px;font-weight:800;color:var(--teal)}\n.faq h3{font-size:17px;color:var(--slate-deep);margin-bottom:8px}\n.faq h3::before{content:\"问：\";color:var(--teal-deep)}\n.faq p{font-size:14.5px;color:var(--slate-mid)}\n.faq p::before{content:\"答：\";font-weight:700;color:var(--slate-deep)}\n\nfooter{background:var(--slate-deep);color:#8fa0ac;font-size:13px;padding:36px 0;text-align:center}\nfooter .brand{color:#fff;font-weight:600;letter-spacing:.1em}\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumb\" aria-label=\"面包屑\">\n      <a href=\"#\">首页</a><span class=\"sep\">/</span><a href=\"#plans\">套餐</a><span class=\"sep\">/</span><span>小飞象(Blizzard) 选购专栏</span>\n    </nav>\n    <nav class=\"toc\" aria-label=\"目录\">\n      <a href=\"#think\">先想清楚</a>\n      <a href=\"#plans\">三档套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#start\">上手步骤</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n<section class=\"hero\">\n  <div class=\"wrap\">\n    <span class=\"kicker\">选购专栏 · 第 4996 期</span>\n    <h1>小飞象(Blizzard)：<br>在点「购买」之前，<br>先回答<em>三个问题</em>。</h1>\n    <p class=\"byline\">写给正在对比套餐的你 · 阅读约需 4 分钟</p>\n    <p class=\"lede\">大多数人选错套餐，不是因为看不懂参数，而是因为没问自己问题。这一篇不谈玄学，只谈三个问题：你每个月到底用掉多少流量？你有几台设备会同时在线？你需不需要为游戏或高清流媒体多付一点？</p>\n    <p><span class=\"q\">第一个问题：流量。</span>如果你只是日常浏览、偶尔看剧，每月 100GB 绰绰有余；如果你是 4K 视频的重度观众，300GB 才睡得安稳；而一个小团队共享时，1000GB 只是起步价。</p>\n    <p><span class=\"q\">第二个问题：设备。</span>手机、平板、电脑同时挂着，就是 3 台。家里再加两台，就是 5 台。设备数决定你该站在哪一档，别买小了天天踢设备下线，也别买大了让额度睡大觉。</p>\n    <p><span class=\"q\">第三个问题：场景。</span>追剧、办公、打游戏，对线路的要求完全不同。想清楚了，下面的三档套餐会自己对号入座。</p>\n  </div>\n</section>\n\n<section id=\"think\">\n  <div class=\"wrap\">\n    <h2><span class=\"no\">01 / 自测</span>四个信号，帮你对号入座</h2>\n    <p class=\"sec-intro\">不用精确计算，凭感觉就能判断。下面哪一张卡片最像你？</p>\n    <div class=\"numgrid\">\n      <div class=\"numcard\">\n        <h3>「我就刷刷网页看看剧」</h3>\n        <p>轻度使用，流量消耗可预测，设备不超过三台。你要的是省心，不是堆料。</p>\n        <span class=\"big\">1</span>\n      </div>\n      <div class=\"numcard\">\n        <h3>「我手机平板笔记本全在线」</h3>\n        <p>多设备党，随时随地切换屏幕。同时在线数是你的硬指标，5 台起步才够用。</p>\n        <span class=\"big\">2</span>\n      </div>\n      <div class=\"numcard\">\n        <h3>「晚上我要打排位」</h3>\n        <p>对延迟敏感，愿意为游戏优化线路多付一点。卡顿一次，比月费贵多了。</p>\n        <span class=\"big\">3</span>\n      </div>\n      <div class=\"numcard\">\n        <h3>「我们是一个小团队」</h3>\n        <p>多人共享、流量池要大、设备数要多，还希望有人专门对接。个人套餐已经装不下你了。</p>\n        <span class=\"big\">4</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <h2><span class=\"no\">02 / 套餐</span>三档，逐行看清楚</h2>\n    <p class=\"sec-intro\">不做横向表格的眼花对比，一档一档往下看，看到「这说的就是我」那一档，停。</p>\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>基础版</h3>\n          <span class=\"price\">¥15/月</span>\n          <span class=\"annual\">按年付仅需 ¥150/年</span>\n        </div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <p class=\"who\">单人轻度使用，预算优先，设备少、流量省。</p>\n        <span class=\"bigno\">01</span>\n      </article>\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>旗舰版</h3>\n          <span class=\"tag\">最多人选</span>\n          <span class=\"price\">¥35/月</span>\n          <span class=\"annual\">按年付仅需 ¥350/年</span>\n        </div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <p class=\"who\">多设备、爱追剧、打游戏，希望一次到位不再纠结。</p>\n        <span class=\"bigno\">02</span>\n      </article>\n      <article class=\"plan\">\n        <div class=\"plan-head\">\n          <h3>团队版</h3>\n          <span class=\"price\">¥85/月</span>\n          <span class=\"annual\">按年付仅需 ¥850/年</span>\n        </div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <p class=\"who\">工作室、小团队共享使用，需要定制与专人对接。</p>\n        <span class=\"bigno\">03</span>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"clients\" class=\"clients\">\n  <div class=\"wrap\">\n    <h2><span class=\"no\">03 / 客户端</span>用什么连？</h2>\n    <p class=\"sec-intro\">关于客户端，我们只说有把握的话。</p>\n    <div class=\"client-note\">\n      <p><strong>目前官方客户端与下载方式以购买后站内指引为准。</strong>不同平台（桌面与移动端）的可用客户端、配置方法会在你开通套餐后，于用户中心内提供对应说明。在确认自己的设备和系统版本之前，不建议从第三方渠道获取来路不明的安装包。</p>\n    </div>\n  </div>\n</section>\n\n<section id=\"start\">\n  <div class=\"wrap\">\n    <h2><span class=\"no\">04 / 上手</span>四步，从犹豫到用上</h2>\n    <p class=\"sec-intro\">流程不复杂，复杂的是下决心。看完首屏的三个问题，你已经完成了一半。</p>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <span class=\"n\">1</span>\n        <div>\n          <h3>回答首屏的三个问题</h3>\n          <p>流量、设备数、使用场景。写下你的答案，哪怕只是大概的数字。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">2</span>\n        <div>\n          <h3>对照三档套餐逐行看</h3>\n          <p>从基础版开始往下看，看到权益刚好覆盖你答案的那一档，就是它。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">3</span>\n        <div>\n          <h3>决定月付还是年付</h3>\n          <p>年付价格更划算（如旗舰版 ¥350/年），但如果不确定长期使用，先月付试用也完全可以。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <span class=\"n\">4</span>\n        <div>\n          <h3>开通后按站内指引配置客户端</h3>\n          <p>根据你的设备选择对应客户端，按用户中心的说明完成配置，遇到问题走工单。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\" class=\"faq\">\n  <div class=\"wrap\">\n    <h2><span class=\"no\">05 / FAQ</span>你可能还想问</h2>\n    <p class=\"sec-intro\">编号列表，逐条看。没找到答案的，开通后走工单问。</p>\n    <ol>\n      <li>\n        <h3>100GB 一个月到底够不够？</h3>\n        <p>看用法。日常网页、社交、标清视频，100GB 通常有富余；如果经常看高清或 4K 流媒体，建议直接上 300GB 的旗舰版，免得月中焦虑。</p>\n      </li>\n      <li>\n        <h3>设备同时在线数超了会怎样？</h3>\n        <p>超出套餐设备数时，先连的设备可能被挤下线。如果你常年多设备并用，选档时把设备数放在第一位考虑。</p>\n      </li>\n      <li>\n        <h3>基础版和旗舰版的流媒体解锁差在哪？</h3>\n        <p>基础版解锁基础流媒体，旗舰版为全节点原生流媒体解锁。追剧范围广、对清晰度有要求的用户，旗舰版更稳。</p>\n      </li>\n      <li>\n        <h3>打游戏应该选哪档？</h3>\n        <p>旗舰版包含 IPLC 专线游戏加速优化，是三档中唯一针对游戏场景优化的选项。对延迟敏感的话，答案很明确。</p>\n      </li>\n      <li>\n        <h3>团队版和个人版除了量还有什么区别？</h3>\n        <p>团队版支持企业定制路由，并配有专属客户经理服务，适合需要统一管理和定制需求的小团队，而不只是「流量更多的个人版」。</p>\n      </li>\n      <li>\n        <h3>年付和月付怎么选？</h3>\n        <p>三档套餐年付均有优惠（基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年）。确定长期使用选年付更省；第一次用，先月付体验一个月也不迟。</p>\n      </li>\n    </ol>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p class=\"brand\">小飞象(Blizzard)</p>\n    <p>先想清楚，再下单。本篇为选购说明专栏，具体服务以开通后站内信息为准。</p>\n  </div>\n</footer>",
